generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum ResponseStatus {
  APPROVED
  REJECTED
}

model User {
  id        String   @id @default(uuid())
  name      String
  username  String   @unique
  password  String
  role      Role     @default(USER)
  tokenVersion Int   @default(0) @map("token_version")
  email     String?  @unique
  resetToken String? @map("reset_token")
  resetTokenExpiry DateTime? @map("reset_token_expiry")
  profilePictureUrl String? @map("profile_picture_url")
  tasks     QcTask[]
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

model QcTask {
  id           String        @id @default(uuid())
  title        String
  description  String?
  assignedTo   User?         @relation(fields: [assignedToId], references: [id])
  assignedToId String?       @map("assigned_to")
  status       TaskStatus    @default(PENDING)
  checklists   QcChecklist[]
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  @@map("qc_tasks")
}

model QcChecklist {
  id       String      @id @default(uuid())
  taskId   String      @map("task_id")
  task     QcTask      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title    String
  order    Int         @default(0)
  response QcResponse?

  @@map("qc_checklists")
}

model QcResponse {
  id          String         @id @default(uuid())
  checklistId String         @unique @map("checklist_id")
  checklist   QcChecklist    @relation(fields: [checklistId], references: [id], onDelete: Cascade)
  status      ResponseStatus
  comment     String
  imageUrl    String         @map("image_url")
  createdAt   DateTime       @default(now()) @map("created_at")

  @@map("qc_responses")
}
